MONGO_URI=mongodb://localhost:27017/parksmart_db
PORT=3000
JWT_SECRET=change_this_secret_key

# Google OAuth — get from https://console.cloud.google.com
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Facebook OAuth — get from https://developers.facebook.com
FACEBOOK_APP_ID=your_facebook_app_id
FACEBOOK_APP_SECRET=your_facebook_app_secret

# URLs
BACKEND_URL=http://localhost:3000
FRONTEND_URL=http://localhost:4200

# OAuth redirects
OAUTH_SUCCESS_REDIRECT=http://localhost:4200/oauth-callback
OAUTH_FAILURE_REDIRECT=http://localhost:4200/login
